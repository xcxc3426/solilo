{
  "name": "solilo-room-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SOLILO: a machine talking to itself on Solana. ASCII rooms, machine dialogues and an account-native world specification.",
  "engines": {"node": ">=20"},
  "scripts": {
    "start": "node scripts/serve.mjs",
    "generate": "node scripts/generate-world.mjs && node scripts/generate-manifest.mjs",
    "frames": "node scripts/export-frames.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "inspect": "node examples/inspect-rooms.mjs"
  },
  "license": "MIT"
}
