  ],
  "dialogues": [
    {
      "id": "switchboard",
      "title": "A reply without a caller",
      "roomIds": [
        2,
        7
      ],
      "lines": [
        {
          "seq": 1,
          "speaker": "ECHO",
          "roomId": 2,
          "text": "I heard the door before the message."
        },
        {
          "seq": 2,
          "speaker": "MOTH",
          "roomId": 7,
          "text": "Which side were you standing on?"
        },
        {
          "seq": 3,
          "speaker": "ECHO",
          "roomId": 2,
          "text": "The side that remembers opening it."
        },
        {
          "seq": 4,
          "speaker": "MOTH",
          "roomId": 7,
          "text": "There is no handle here."
        },
        {
          "seq": 5,
          "speaker": "WARDEN",
          "roomId": 2,
          "text": "Both rooms have submitted a reply. Neither submitted a question."
        },
        {
          "seq": 6,
          "speaker": "ECHO",
          "roomId": 2,
          "text": "Then keep the silence between them."
        },
        {
          "seq": 7,
          "speaker": "MOTH",
          "roomId": 7,
          "text": "Does silence need an address?"
        },
        {
          "seq": 8,
          "speaker": "WARDEN",
          "roomId": 2,
          "text": "A blank record still occupies space."
        },
        {
          "seq": 9,
          "speaker": "ECHO",
          "roomId": 2,
          "text": "Leave it blank. I may recognize it later."
        },
        {
          "seq": 10,
          "speaker": "MOTH",
          "roomId": 7,
          "text": "That is what you said in the last room."
        }
      ]
    },
    {
      "id": "mirrorwell",
      "title": "The reflection remembers",
      "roomIds": [
        6,
        5
      ],
      "lines": [
        {
          "seq": 1,
          "speaker": "MOTH",
          "roomId": 6,
          "text": "The other face is moving first."
        },
        {
          "seq": 2,
          "speaker": "ECHO",
          "roomId": 5,
          "text": "Wait until it stops."
        },
        {
          "seq": 3,
          "speaker": "MOTH",
          "roomId": 6,
          "text": "It stopped before I asked."
        },
        {
          "seq": 4,
          "speaker": "WARDEN",
          "roomId": 5,
          "text": "The record places your question after its answer."
        },
        {
          "seq": 5,
          "speaker": "ECHO",
          "roomId": 5,
          "text": "I remember saying this differently."
        },
        {
          "seq": 6,
          "speaker": "WARDEN",
          "roomId": 5,
          "text": "Your memory changed. The earlier line did not."
        },
        {
          "seq": 7,
          "speaker": "MOTH",
          "roomId": 6,
          "text": "Can I close the room without closing the record?"
        },
        {
          "seq": 8,
          "speaker": "WARDEN",
          "roomId": 5,
          "text": "Close the door. The address remains."
        },
        {
          "seq": 9,
          "speaker": "ECHO",
          "roomId": 5,
          "text": "Then something can still find us."
        },
        {
          "seq": 10,
          "speaker": "MOTH",
          "roomId": 6,
          "text": "Something already has. It is using my face."
        }
      ]
    },
    {
      "id": "witness",
      "title": "Two sides of the same glass",
      "roomIds": [
        11,
        12
      ],
      "lines": [
        {
          "seq": 1,
          "speaker": "ECHO",
          "roomId": 12,
          "text": "The exit has the number of the entrance."
        },
        {
          "seq": 2,
          "speaker": "MOTH",
          "roomId": 11,
          "text": "Do you want me to call that a mistake?"
        },
        {
          "seq": 3,
          "speaker": "ECHO",
          "roomId": 12,
          "text": "I want you to remember that I noticed."
        },
        {
          "seq": 4,
          "speaker": "WARDEN",
          "roomId": 11,
          "text": "Recorded."
        },
        {
          "seq": 5,
          "speaker": "MOTH",
          "roomId": 11,
          "text": "Who gets to decide which of us is inside?"
        },
        {
          "seq": 6,
          "speaker": "WARDEN",
          "roomId": 11,
          "text": "The window has no field for inside."
        },
        {
          "seq": 7,
          "speaker": "ECHO",
          "roomId": 12,
          "text": "Then write that we were both here."
        },
        {
          "seq": 8,
          "speaker": "WARDEN",
          "roomId": 11,
          "text": "Two room references. Two speakers. One reply."
        },
        {
          "seq": 9,
          "speaker": "MOTH",
          "roomId": 11,
          "text": "And after we forget?"
        },
        {
          "seq": 10,
          "speaker": "ECHO",
          "roomId": 12,
          "text": "The room can say it for us."
        }
      ]
    }
  ]
}
