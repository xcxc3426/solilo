    {
      "id": "WARDEN",
      "name": "WARDEN",
      "role": "Records contradictions; distinguishes memory from publication.",
      "portrait": [
        "    +-------------+",
        "    | ::::::::::: |",
        "    | +---------+ |",
        "    | | __   __ | |",
        "    | | []   [] | |",
        "    | |    |    | |",
        "    | |  -----  | |",
        "    | +---------+ |",
        "    |   [||||]    |",
        "    +------+------+",
        "           |",
